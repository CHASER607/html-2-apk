<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Market Bot Manual Start with Live Clock</title>
<style>
  body {
    background: linear-gradient(135deg, #1c1c1c, #000);
    color: white;
    font-family: 'Segoe UI', sans-serif;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .bot-container {
    background: radial-gradient(circle at top left, #222, #111);
    border-radius: 20px;
    padding: 20px;
    width: 340px;
    text-align: center;
    margin-top: 20px;
    box-shadow: 0 0 25px rgba(0, 255, 200, 0.3);
    transition: all 0.3s ease-in-out;
  }
  .bot-logo {
    width: 80px;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 5px #0ff);
  }
  select {
    width: 100%;
    padding: 10px;
    margin-top: 10px;
    font-size: 16px;
    border-radius: 10px;
    border: none;
    background-color: #222;
    color: #fff;
  }
  .signal {
    margin-top: 20px;
    padding: 15px;
    border-radius: 10px;
    font-size: 22px;
    font-weight: bold;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
  }
  .strong-buy { background-color: #00ff88; color: #000; }
  .strong-sell { background-color: #ff3333; color: #000; }
  .wait { background-color: #555; }
  .label {
    font-size: 12px;
    color: #aaa;
    margin-top: 15px;
  }
  .value {
    font-size: 18px;
    font-weight: bold;
    color: #f7c948;
  }
  .score {
    margin-top: 15px;
    background-color: #ffc107;
    color: black;
    padding: 10px;
    border-radius: 10px;
    font-weight: bold;
    font-size: 18px;
  }
  .power {
    margin-top: 10px;
    font-size: 14px;
    color: #00ffff;
  }
  .clock {
    margin-top: 15px;
    font-size: 16px;
    color: #0ff;
    font-weight: bold;
  }
  .chart-container {
    width: 100%;
    max-width: 500px;
    height: 400px;
    margin-top: 20px;
  }
  button {
    margin-top: 15px;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    box-shadow: 0 0 10px #00b894aa;
    transition: background-color 0.3s ease;
    color: white;
    background-color: #0984e3;
  }
  button:hover {
    background-color: #0652dd;
  }
</style>
</head>
<body>
  <div class="bot-container">
    <img src="https://i.imgur.com/3X2HZx9.png" alt="Robot Logo" class="bot-logo" />

    <div class="label">ASSET</div>
    <select id="assetSelector">
      <option value="FX:AUDCAD">AUD/CAD</option>
      <option value="FX:EURUSD">EUR/USD</option>
      <option value="OANDA:XAUUSD">GOLD</option>
      <option value="OANDA:NAS100USD">NAS100</option>
      <option value="BINANCE:BTCUSDT">BTC/USDT</option>
      <option value="BINANCE:ETHUSDT">ETH/USDT</option>
    </select>

    <div class="label">TIMEFRAME</div>
    <select id="timeframeSelector">
      <option value="1">1 Min</option>
      <option value="5">5 Min</option>
      <option value="15">15 Min</option>
      <option value="30">30 Min</option>
      <option value="60">1 Hour</option>
    </select>

    <div id="signalDisplay" class="signal wait">Press Start to get signal</div>
    <div id="directionNote" class="power">Direction: Waiting for start...</div>

    <div class="label">TIMEFRAME SELECTED</div>
    <div class="value" id="selectedTime">1 MIN</div>

    <div class="score" id="scoreDisplay">1:0 C</div>
    <div class="power" id="botPower">Bot Accuracy: 97%</div>

    <div class="clock" id="clock">--:--:--</div>

    <button id="startBtn">▶️ Start Bot</button>
  </div>

  <div class="chart-container">
    <iframe id="tvChart"
      src="https://s.tradingview.com/widgetembed/?frameElementId=tvChart&symbol=FX:AUDCAD&interval=1&theme=dark&style=1&locale=en&toolbar_bg=rgba(0,0,0,1)&hide_top_toolbar=true&hide_legend=true&save_image=false&studies=[]"
      width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
  </div>

<script>
  const assetSelector = document.getElementById("assetSelector");
  const timeframeSelector = document.getElementById("timeframeSelector");
  const tvChart = document.getElementById("tvChart");
  const signalDisplay = document.getElementById("signalDisplay");
  const directionNote = document.getElementById("directionNote");
  const selectedTime = document.getElementById("selectedTime");
  const botPower = document.getElementById("botPower");
  const clock = document.getElementById("clock");
  const startBtn = document.getElementById("startBtn");

  let lastSignal = "WAIT";

  // Only strong buy or strong sell signals allowed when manual start
  const signals = [
    { text: "Strong Buy", class: "strong-buy" },
    { text: "Strong Sell", class: "strong-sell" }
  ];

  // Update TradingView chart based on asset and timeframe selection
  function updateChart() {
    const asset = assetSelector.value;
    const tf = timeframeSelector.value;
    tvChart.src = `https://s.tradingview.com/widgetembed/?frameElementId=tvChart&symbol=${asset}&interval=${tf}&theme=dark&style=1&locale=en&toolbar_bg=rgba(0,0,0,1)&hide_top_toolbar=true&hide_legend=true&save_image=false&studies=[]`;
  }

  // Update displayed timeframe text
  function updateTimeText() {
    selectedTime.textContent = timeframeSelector.options[timeframeSelector.selectedIndex].text.toUpperCase();
  }

  // Generate strong buy or sell signal manually
  function generateSignal() {
    const now = new Date();
    const day = now.getUTCDay(); // Sunday=0, Saturday=6

    if(day === 0 || day === 6) {
      signalDisplay.textContent = "MARKET CLOSED";
      signalDisplay.className = "signal wait";
      directionNote.textContent = "Market is closed on weekends";
      return;
    }

    const pick = signals[Math.floor(Math.random() * signals.length)];
    signalDisplay.textContent = pick.text;
    signalDisplay.className = `signal ${pick.class}`;

    if(lastSignal !== pick.text) {
      directionNote.textContent = `Direction: Market Reversing to ${pick.text}`;
    } else {
      directionNote.textContent = `Direction: Confirmed ${pick.text}`;
    }

    lastSignal = pick.text;
    botPower.textContent = `Bot Accuracy: 97%`;
  }

  // Update the clock every second - real Earth time
  function updateClock() {
    const now = new Date();
    clock.textContent = now.toLocaleTimeString();
  }

  // Event listeners
  assetSelector.addEventListener("change", () => {
    updateChart();
  });
  timeframeSelector.addEventListener("change", () => {
    updateTimeText();
    updateChart();
  });

  startBtn.addEventListener("click", generateSignal);

  // Initial setup
  updateTimeText();
  updateChart();
  updateClock();
  setInterval(updateClock, 1000); // Keep clock live every second
</script>
</body>
</html>
